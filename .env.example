# Copy this file to .env and fill in your Twitter cookies.

# Twitter Authentication Cookies
# You can get these cookies from your browser's developer tools
# when logged into Twitter/X → Application/Storage → Cookies
TWITTER_CT0=your_ct0_cookie_here
TWITTER_AUTH_TOKEN=your_auth_token_cookie_here

# Tools read these values from the environment automatically. Do not pass
# cookies in tool arguments or commit a filled .env file.

# Optional Xquik companion MCP server for reviewed X/Twitter API workflows.
# Used only by mcp_config.xquik.example.json.
XQUIK_API_KEY=your_xquik_api_key_here
