{
  "mcpServers": {
    "twitter": {
      "command": "python3",
      "args": ["server.py"],
      "env": {
        "TWITTER_AUTH_TOKEN": "${TWITTER_AUTH_TOKEN}",
        "TWITTER_CT0": "${TWITTER_CT0}"
      }
    },
    "xquik": {
      "url": "https://xquik.com/mcp",
      "headers": {
        "x-api-key": "${XQUIK_API_KEY}"
      }
    }
  }
}
